# =============================================================================
# frameo-clone / server  --  environment template
# =============================================================================
# Copy this file to ".env" IN THE SAME DIRECTORY as docker-compose.immich.yml
# and fill in the secrets:
#
#     cp .env.example .env
#     chmod 600 .env
#     ${EDITOR:-nano} .env
#
# Deployment root on the target host: /home/youruser/frameo. deploy.sh replaces
# /home/youruser/frameo and the uid/gid below with the real values when it
# creates .env for you; if you copy the file by hand, edit them yourself.
# .env is read automatically by `docker compose -f docker-compose.immich.yml`
# because it lives in the project directory. To use a different file, pass
# `--env-file <path>` explicitly.
#
# NEVER commit the real .env. Only this .example file belongs in the repo.
# =============================================================================

# Where the data, config and logs live, and the host user (uid/gid) that owns
# them. The signalling and TURN containers run as this uid/gid.
FRAMEO_ROOT=/home/youruser/frameo
FRAMEO_UID=1000
FRAMEO_GID=1000


# -----------------------------------------------------------------------------
# SECTION 1 - Immich photo backend
# -----------------------------------------------------------------------------

# Immich release to run. PINNED ON PURPOSE - do not use "release" or "latest".
# v3.1.0 is the current stable line as of August 2026.
# Upgrades are a deliberate act: bump this, read the release notes for breaking
# changes, then `docker compose ... pull && up -d`. Immich runs irreversible
# database migrations on first start of a new version, so BACK UP FIRST and
# never roll the tag backwards.
IMMICH_VERSION=v3.1.0

# Timezone for the server container and for EXIF date handling of assets that
# carry no timezone. Must be a tz database identifier.
TZ=Europe/Bucharest

# --- Storage locations (HOST paths, absolute) --------------------------------
# Photo and video library, plus thumbnails, encoded video and profile images.
# This is the directory that grows without bound - see README-immich.md for how
# to move it onto a quota-ed filesystem later.
# Mounted read-write into the server container at /data.
UPLOAD_LOCATION=/home/youruser/frameo/data/immich

# PostgreSQL data directory. MUST be on a local POSIX filesystem - NFS, SMB,
# sshfs and friends will corrupt it. Keep it separate from UPLOAD_LOCATION so
# the library can be moved to another disk without touching the database.
DB_DATA_LOCATION=/home/youruser/frameo/data/postgres

# --- Database credentials ----------------------------------------------------
# REQUIRED. There is no default; the stack refuses to start without it.
#
# Constraint from Immich: use ONLY the characters A-Za-z0-9. Special characters
# break the postgres connection URL that the server builds internally.
#
# Generate one with:
#     tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 40; echo
#
# This password is baked into the Postgres data directory on FIRST start. To
# change it afterwards you must ALTER USER inside the running database as well
# as editing this file - editing this file alone will lock you out.
DB_PASSWORD=CHANGEME_generate_a_40_char_alphanumeric_password

# The two values below match Immich's defaults and normally need no change.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# --- Tuning ------------------------------------------------------------------
# SSD or HDD. Selects which tuned postgresql.conf the Immich Postgres image
# loads (random_page_cost, effective_io_concurrency, autovacuum aggressiveness).
# Use SSD unless the database lives on a spinning disk.
DB_STORAGE_TYPE=SSD

# Server log verbosity: verbose | debug | log | warn | error
# Use "debug" while bringing the stack up, then drop back to "log" so the
# json-file log driver is not doing needless work.
IMMICH_LOG_LEVEL=log


# -----------------------------------------------------------------------------
# SECTION 2 - notes on variables this stack deliberately does NOT set
# -----------------------------------------------------------------------------
# IMMICH_MACHINE_LEARNING_ENABLED  is hardcoded to "false" in
#     docker-compose.immich.yml, not exposed here, because there is no
#     machine-learning container in this deployment and toggling it from .env
#     would suggest otherwise.
#
# DB_URL / REDIS_URL  are not used. The stack sets DB_HOSTNAME and
#     REDIS_HOSTNAME explicitly instead, because our service names
#     (immich-postgres / immich-redis) differ from Immich's built-in defaults
#     ("database" / "redis"). If you ever set DB_URL it overrides all DB_*.
#
# IMMICH_MEDIA_LOCATION  stays at the container default /data. Changing it on
#     an existing install orphans every asset path in the database.
#
# The published host port is fixed at 127.0.0.1:2283 in the compose file rather
#     than being configurable, so it cannot be widened to 0.0.0.0 by editing an
#     env file.


# -----------------------------------------------------------------------------
# SECTION 3 - signalling server (docker-compose.signalling.yml)
# -----------------------------------------------------------------------------

# REQUIRED for the ring channel. Bearer token that authenticates the POST
# /api/call and POST /api/hangup control endpoints on the signalling server.
# Leaving it empty DISABLES the control API entirely, which means the laptop
# cannot push a ring to the tablets and calls can only be started from a page
# that is already open.
#
# Generate one with:
#     openssl rand -hex 32
#
# Anything holding this token can make the frames ring, so treat it as a
# secret: it belongs in .env (mode 0600) and in the ring script on this host,
# nowhere else.
CONTROL_TOKEN=

# How long an unanswered call keeps ringing before it is logged as "missed".
# 45s rather than the usual 20s on purpose: the grandparents may need to cross
# a room to reach the frame.
RING_TIMEOUT_MS=45000

# WebSocket liveness sweep, and how long a freshly connected client has to send
# its "register" message before being dropped. Defaults are fine.
HEARTBEAT_INTERVAL_MS=30000
REGISTER_TIMEOUT_MS=10000

# Hard cap on simultaneous calls. There are two frames, so two.
MAX_CONCURRENT_CALLS=2

# --- Frame watchdog liveness --------------------------------------------------
# The tablets POST /api/frame-heartbeat once a minute over the PUBLIC Funnel URL
# (so the report still arrives when their tailnet path is the thing that broke).
# The state file is what server/frame-heartbeat-alert.sh reads from cron; /data
# inside the container is ${FRAMEO_ROOT}/logs on the host.
FRAME_HEARTBEAT_PATH=/data/frame-heartbeats.json
# A frame with no heartbeat for this long is reported "stale" in /api/health.
FRAME_STALE_MS=900000
# Heartbeats arriving faster than this per frame are answered 200 but ignored.
FRAME_HEARTBEAT_MIN_MS=20000

# --- Container-internal paths and ports ---------------------------------------
# These are set as literals in docker-compose.signalling.yml and are listed here
# only so the full set of variables the server reads is documented in one place.
# Changing them in .env has NO effect unless you also change the compose file.
#   PORT=8080                      listen port inside the container
#   BIND_ADDR=0.0.0.0              inside the container; the HOST publication is
#                                  127.0.0.1:8080 and must never become 0.0.0.0
#   PUBLIC_DIR=/app/public         static client bundle (bind-mounted)
#   ROSTER_PATH=/config/roster.json
#   CALL_LOG_PATH=/data/calls.jsonl
#   WS_PATH=/ws                    must match the client and `tailscale funnel`

# How often the server re-reads roster.json (mtime poll), in ms. 0 disables hot
# reload and you would have to restart the container after every roster edit.
ROSTER_RELOAD_MS=15000

# --- Photo feed for the tablets ----------------------------------------------
# The tablets never talk to Immich directly. They ask the signalling server for
#     GET /api/photos?limit=300   ->  { "photos": [ { "id", "url" } ] }
#     GET /api/photo/<assetId>    ->  the preview JPEG
# and it proxies Immich. That keeps the API key on the server and keeps every
# URL on one origin, which is what lets the tablet's service worker cache the
# photos and survive this box being switched off.
#
# REQUIRED for the slideshow to have any content on a fresh install. Create it
# in Immich: Account Settings -> API Keys -> New API Key (read access is
# enough). While it is empty, /api/photos returns an empty manifest and the
# frames show only what they had already cached.
IMMICH_API_KEY=

# Which photos to show. Comma-separated Immich ALBUM ids (copy them out of the
# album URL). Empty means "the newest images in the whole library", which is
# fine for a first boot but is not what you want long term - curate an album
# per household and list it here.
IMMICH_ALBUM_IDS=

# Immich base URL as seen from the signalling container. Both containers are on
# the external `frameo` docker network, so this is the container name, NOT
# 127.0.0.1:2283 (that publication is host-side only and is not reachable from
# inside another container).
IMMICH_URL=http://immich-server:2283

# How many photos the manifest carries, and how long it is cached before the
# server re-asks Immich. 300 photos matches the service worker's cache cap.
PHOTO_LIMIT=300
PHOTO_MANIFEST_TTL_MS=300000

# --- One-off bulk import (import-photos.js) ----------------------------------
# ./import-photos.js /home/youruser/frameo/photos-seed
# reads the three variables above and needs nothing else. These four are only
# overrides, all optional - see README-import.md.
#
# IMMICH_IMPORT_API_KEY  Use a DIFFERENT key for importing than the one the
#                        signalling server uses. Recommended: IMMICH_API_KEY
#                        above can stay read-only, while this one carries
#                        asset.upload + album.read + albumAsset.create (and
#                        asset.delete only if you use --restore-trashed).
#                        Unset = fall back to IMMICH_API_KEY.
# IMMICH_IMPORT_URL      Immich base URL as seen from the HOST, where the
#                        importer runs. IMMICH_URL above is a docker-network
#                        name and does NOT resolve on the host, so the importer
#                        probes http://127.0.0.1:2283 by itself. Set this only
#                        if you moved the published port.
# IMMICH_IMPORT_ALBUM    Album name or uuid to import into. Default "Toti".
# IMMICH_IMPORT_TZ       How to read YYYYMMDD_HHMMSS filenames. Default
#                        Europe/Bucharest.
IMMICH_IMPORT_API_KEY=
IMMICH_IMPORT_URL=
IMMICH_IMPORT_ALBUM=
IMMICH_IMPORT_TZ=


# -----------------------------------------------------------------------------
# SECTION 4 - host / operations (deploy.sh, healthcheck.sh)
# -----------------------------------------------------------------------------
# These are NOT read by docker compose. They are here so that one file
# documents every knob; export them in your shell when you want to override a
# default, e.g.  FRAME_HOSTNAME=... ./healthcheck.sh
#
# FRAME_HOSTNAME     MagicDNS name of this node. Auto-detected from
#                    `tailscale status --json` when unset. Example:
#                    your-machine.your-tailnet.ts.net
#                    The tablets MUST use this name, never a 100.x IP: an IP is
#                    not a secure origin, so the camera would fail silently.
# FRAMEO_ROOT        Data root on the host (set at the top of this file).
#                    It is read by docker compose too (the stacks bind-mount
#                    ${FRAMEO_ROOT}/config and ${FRAMEO_ROOT}/logs), so keep the
#                    value here and in your shell the same.
# FRAMEO_USER        deploy.sh: owner of the data directories. Default: the
#                    user running deploy.sh (or $SUDO_USER under sudo).
# SKIP_TAILSCALE=1   deploy.sh: skip the `tailscale serve` step
# SKIP_IMMICH=1      deploy.sh: do not touch the Immich stack
#                    healthcheck.sh: a missing Immich is a warning, not a failure
# MEM_WARN_PCT       healthcheck.sh: per-container memory warning threshold (80)
# MEM_FAIL_PCT       healthcheck.sh: per-container memory failure threshold (95)
# DISK_MIN_FREE_PCT  healthcheck.sh: minimum free space on / (15)
# PROTECTED_CONTAINER=name
#                    deploy.sh: a neighbouring container that must survive the
#                    deploy untouched. Checked before and after; any restart is
#                    a loud failure. Unset = only the Docker daemon is checked.
# ALLOW_PROTECTED_DOWN=1
#                    deploy.sh: proceed even though PROTECTED_CONTAINER is not
#                    running. This disables that check for the run.
#
# --- frame-heartbeat-alert.sh (cron every 5 min) -----------------------------
# The tablets run tablet/tailscale-watchdog.sh under Termux:Boot and POST
# /api/frame-heartbeat once a minute over the PUBLIC Funnel URL. That is what
# lets the alert tell "tablet off" apart from "tablet up but Tailscale dead".
# See tablet/README-watchdog.md.
#
# HEARTBEAT_STATE     Liveness file written by the signalling server.
#                     Default ${FRAMEO_ROOT}/logs/frame-heartbeats.json
# FRAME_STALE_MINUTES Alert when a frame has not reported for this long (15)
# ALERT_URL           ntfy-style endpoint the alert is POSTed to, e.g.
#                     https://ntfy.sh/<your-private-topic>. Unset = print only.
# ALERT_REPEAT_MINUTES Do not resend an identical alert more often than this (60)
# QUIET_HOURS         e.g. 23-7: suppress SENDING overnight. The check still runs
#                     and still exits non-zero.
# STATE_DIR           De-duplication stamps. Default ${FRAMEO_ROOT}/logs/alert-state


# -----------------------------------------------------------------------------
# SECTION 5 - public exposure: Tailscale Funnel + coturn TURN relay
# -----------------------------------------------------------------------------
# Everything below exists so that a phone on mobile data - with NO Tailscale app
# installed and NO router port-forwarding - can open the app and make a video
# call. See README-public.md and ARCHITECTURE-PUBLIC.md sections 1, 3 and 5.
#
# Read by: docker-compose.turn.yml, docker-compose.signalling.yml,
#          render-turnserver-conf.sh, expose-public.sh, signalling/ice.js.
#
# After editing anything here, the signalling container must be RESTARTED
# (`docker compose -f docker-compose.signalling.yml up -d`) - it reads these
# once at boot, unlike roster.json which is hot-reloaded.

# The canonical public origin. No trailing slash. This is the node's MagicDNS
# name, and it is also the only name Funnel can ever serve: a custom domain such
# as frame.example.com is impossible, because the ingress routes on the TLS SNI and
# only holds a certificate for the ts.net name.
#
# Used for the WebSocket Origin check, the CSP connect-src, and to derive
# TURN_PUBLIC_URL when that is left empty.
PUBLIC_ORIGIN=https://your-machine.your-tailnet.ts.net

# This node's tailnet IPv4, from `tailscale ip -4`. A 100.64.0.0/10 address.
#
# It is the single most load-bearing value in this section: coturn BINDS it and
# allocates every relay port on it, which is the entire reason a TURN server can
# work on a host with no public UDP. The frames, being tailnet nodes, reach
# those relay ports directly.
#
# If this is wrong, coturn refuses to start (visible: restart loop in
# `docker ps`). If it is stale after a re-key, same thing. That is deliberate -
# the alternative failure mode is a relay that hands out unreachable candidates
# and calls that fail silently.
TS_TAILNET_IP=100.64.0.1

# Shared secret between coturn (`static-auth-secret`) and the signalling server,
# which mints ephemeral TURN credentials from it:
#   username = "<unix-expiry>:<roster-peer-id>"
#   password = base64(HMAC-SHA1(secret, username))
#
# Generate with:  openssl rand -hex 32
# The two sides must match EXACTLY; a mismatch shows up as "Trickle-ICE gets an
# srflx candidate but never a relay one".
# Rotating it instantly invalidates every outstanding credential; re-run
# ./render-turnserver-conf.sh and restart both containers.
TURN_STATIC_AUTH_SECRET=

# TURN URL handed to phones and other public clients. Leave empty to derive it
# from PUBLIC_ORIGIN, which is what you want.
#
# It MUST be `turns:` (TLS) on port 10000: Tailscale Funnel cannot forward
# unencrypted TCP at all, and it only permits ports 443, 8443 and 10000. TLS is
# terminated by tailscaled with the node's own certificate, so coturn holds no
# certificate and needs no renewal mechanism.
# Comma-separate to offer several.
TURN_PUBLIC_URL=turns:your-machine.your-tailnet.ts.net:10000?transport=tcp

# TURN URLs handed to the frames/tablets, which are on the tailnet. Plain
# `turn:` over UDP first (best quality), with TCP as a second entry. Leave empty
# to derive both from TS_TAILNET_IP.
TURN_TAILNET_URL=turn:100.64.0.1:3478?transport=udp,turn:100.64.0.1:3478?transport=tcp

# Lifetime of a minted TURN credential, seconds. 12 h means a phone that logs in
# at breakfast still has a valid credential at bedtime without a refetch, and a
# credential copied off a stolen phone is dead within a day.
TURN_TTL_SECONDS=43200

# Public STUN servers, offered to PUBLIC clients only - never to the frames,
# whose useful candidates are their tailnet and LAN addresses and for whom a
# public STUN server would only leak the grandparents' home IP to a third party.
# Two providers for redundancy. Both are plain UDP and carry no user data.
# Set to empty to disable STUN entirely (calls would then always relay).
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# coturn's `realm`, echoed to clients and printed in its logs. Not a secret and
# it does not have to resolve. Defaults to the host part of PUBLIC_ORIGIN.
#TURN_REALM=your-machine.your-tailnet.ts.net

# HMAC key for session cookies, device cookies and rate-limit key hashing.
# Generate with:  openssl rand -hex 32
# Changing it logs everyone out AND invalidates every frameo_device cookie - it
# is the "a phone was stolen and I want everything revoked now" button.
# ice.js also uses it to verify the frameo_device cookie on GET /api/ice.
SESSION_SECRET=

# --- Not variables, but the two commands that go with this section -----------
#   ./render-turnserver-conf.sh    render turnserver.conf from the values above
#   ./expose-public.sh             enable Funnel; --status to inspect; --off to
#                                  take the whole thing back off the internet


# =============================================================================
# SECTION 5 - ADMIN LOGIN AND THE ADMIN PHOTO API
# =============================================================================
#
# Read by: signalling/server.js -> auth.js, admin.js, immich.js.
# Contract: ARCHITECTURE-PUBLIC.md sections 2.2 - 2.9.
#
# The moment the Funnel is open, "nobody will find the URL" stops being a
# security control: the ts.net hostname lands in Certificate Transparency logs
# the instant the certificate is issued, and CT logs are public and enumerable.
# The security of this system therefore rests ENTIRELY on the password below.
# Use a four-word passphrase. Put it in a password manager.

# The gate. When true (the default and the only correct value with a Funnel
# running), every path except these is refused without a credential:
#   GET  /login, /login.css, /login.js, /favicon.ico
#   POST /api/auth/login          (rate-limited)
#   GET  /api/auth/session        (answers {"authenticated":false} anonymously)
#   GET  /api/health              (answers exactly {"ok":true} anonymously)
#   POST /api/frame-heartbeat     (authenticates with a roster token in the body)
#   POST /api/call, /api/hangup   (Bearer CONTROL_TOKEN)
# Anything else: 302 to /login for a browser, 401 JSON for everything else.
REQUIRE_AUTH=true

# Named admin accounts, scrypt-hashed (N=32768, r=8, p=1). This file lives next
# to roster.json in ${FRAMEO_ROOT}/config, is mounted read-only into the
# container at /config, and is HOT-RELOADED on mtime change - so setting
# "disabled": true on a stolen phone's account takes effect within 15 seconds
# and needs no restart. A malformed file is refused and the previous good copy
# is kept.
#
# Shape:
# {
#   "accounts": [
#     { "username": "ana", "displayName": "Ana",
#       "peerId": "family-ana",
#       "passwordHash": "scrypt$N=32768,r=8,p=1$<salt>$<hash>",
#       "disabled": false }
#   ]
# }
#
# `peerId` binds the account to a roster peer, which is what makes canCall()
# keep working unchanged: a call started from a phone is a call from that peer.
# Give every account its OWN peerId: the server allows one live connection per
# peer, so two phones sharing one would keep kicking each other offline.
#
# Generate a hash on the server (the password is read from stdin, NEVER argv,
# so it never reaches `ps` or the shell history):
#   docker exec -it frameo-signalling node hash-password.js -u ion -d "Ion" -p family-ion
# or, piping from a password manager:
#   printf '%s' "$PW" | docker exec -i frameo-signalling node hash-password.js -u ana
ADMINS_PATH=/config/admins.json

# Optional second source of accounts, for a deployment that would rather keep
# everything in .env than manage a second file. One account per line (or
# separated by ";"), fields separated by "|" - a character that can never occur
# inside a base64url hash:
#
#   ADMIN_PASSWORD_HASHES="ana|Ana|family-ana|scrypt$N=32768,r=8,p=1$AAA$BBB
#   ion|Ion|family-ion|scrypt$N=32768,r=8,p=1$CCC$DDD"
#
# The two-field short form `username|hash` is also accepted and takes its peer
# from ADMIN_DEFAULT_PEER_ID. admins.json wins on a username collision.
#
# NOTE for docker compose: a literal "$" in a .env value is interpreted as
# variable interpolation. Write "$$" to escape it, or use admins.json, which has
# no such problem. admins.json is the recommended route.
ADMIN_PASSWORD_HASHES=
ADMIN_DEFAULT_PEER_ID=family-ana

# Where sessions are mirrored so a container restart does not log three people
# out. Written atomically, mode 0600, at most once every 30 s and once on
# SIGTERM. /data is ${FRAMEO_ROOT}/logs on the host.
SESSION_STORE_PATH=/data/sessions.json

# Sliding session lifetime, seconds. 90 days, refreshed on use. Deliberately
# long: for this user population being logged out unexpectedly is a worse
# failure than a stale session, and revocation (logout-all, "disabled": true, or
# rotating SESSION_SECRET) is the escape hatch.
SESSION_TTL_SECONDS=7776000

# Brute-force protection, all in memory, all keyed on an HMAC of the source
# address so no raw IP ever reaches a log line.
#   per username : 5 failures in 15 min -> 15 min lockout. A correct password
#                  does NOT unlock it early.
#   per source   : 20 failures in 15 min -> 429 for every username from there.
#   global       : 100 failures in 15 min -> 429 for everyone, plus one
#                  auth.global_lockout error line. That is the "we are being
#                  scanned" alarm.
# Unknown-username and wrong-password are indistinguishable: same status, same
# body, same 300 ms delay applied after the scrypt work.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_SOURCE=20
LOGIN_MAX_FAILURES_GLOBAL=100
LOGIN_LOCKOUT_SECONDS=900

# Whether GET /api/auth/session lists the account names to an ANONYMOUS caller.
# Off by default: it would hand a scanner the username half of the credential.
# The login form works without it - the username field is optional, and a
# password alone is matched against every enabled account.
LOGIN_SHOW_ACCOUNTS=false

# Must stay true. Every cookie is Secure; the app is only ever reached over
# HTTPS (tailscaled terminates TLS, the container's plaintext 8080 is bound to
# 127.0.0.1). Set false ONLY for local development against http://localhost.
COOKIE_SECURE=true

# Extra origins accepted on the WebSocket upgrade, comma-separated.
# MUST BE EMPTY IN PRODUCTION. The Origin check is the only thing standing
# between the parents' phones and cross-site WebSocket hijacking, because
# browsers attach cookies to cross-origin WebSocket handshakes and SameSite=Lax
# does not reliably cover them.
EXTRA_ALLOWED_ORIGINS=

# Must remain false (ARCHITECTURE-PUBLIC.md section 4.4). Tailscale injects
# Tailscale-User-Login on TAILNET traffic only, never through the Funnel, and
# the tablets reach us through the Funnel. One auth mechanism is easier to get
# right than two. The server ignores the header regardless of this value and
# logs an error if it is set.
TRUST_TAILSCALE_IDENTITY_HEADER=false

# --- The three curated albums ------------------------------------------------
# Stable keys the phone UI addresses:  a = Bunici A, b = Bunici B, all = Toti.
# Selectors accepted by the API: a | b | all | both (= a + b) | any (= all three)
# | a comma-separated list of keys.
#
# If these are left empty the keys are derived POSITIONALLY from
# IMMICH_ALBUM_IDS (first -> a, second -> b, third -> all) and the derivation is
# logged at boot. Setting them explicitly is safer.
IMMICH_ALBUM_A=
IMMICH_ALBUM_B=
IMMICH_ALBUM_ALL=
IMMICH_ALBUM_A_LABEL=Bunici A
IMMICH_ALBUM_B_LABEL=Bunici B
IMMICH_ALBUM_ALL_LABEL=Toti

# --- Which album each FRAME actually shows ------------------------------------
# Format: "<rosterId>:<albumKey>[+<albumKey>],<rosterId>:<albumKey>"
#
# READ THIS ONE. Without it the three albums above are only a filing system for
# the phone UI: GET /api/photos returns the UNION of every configured album to
# every frame, so a photo sent to "Bunicii A" also appears on the B tablet and
# the album picker in the admin app has no visible effect. Setting the map makes
# the picker mean what it says.
#
# The "all" album (Toti) is ALWAYS added on top of whatever is listed here, so a
# photo uploaded to "Ambele rame" reaches both tablets.
#
# Must use the roster ids from /home/youruser/frameo/config/roster.json.
FRAME_ALBUM_MAP=frame-a:a,frame-b:b

# How long a frame's carousel manifest is cached (one cache entry per distinct
# album set). An upload or a delete drops all of them immediately.
PHOTO_MANIFEST_TTL_MS=300000
# Max photos in one carousel manifest.
PHOTO_LIMIT=300
# Per-request timeout when the signalling server talks to Immich.
IMMICH_TIMEOUT_MS=10000
# How often admins.json is polled for changes (0 disables the watcher; SIGHUP
# still forces a reload). This is how fast "disabled": true takes effect.
ACCOUNTS_RELOAD_MS=15000
# How long Immich album NAMES and counts are cached for GET /api/admin/albums.
ALBUM_META_TTL_MS=600000
# The deviceId reported to Immich on upload, only visible in Immich's own UI.
UPLOAD_DEVICE_ID=frameo-admin

# Photos per page in GET /api/admin/photos (the caller may override up to 500).
ADMIN_PAGE_SIZE=60
# How long the per-album asset index is cached before Immich is re-queried. An
# upload or a delete invalidates it immediately, so this only bounds staleness
# caused by someone editing albums in the Immich UI directly.
ADMIN_INDEX_TTL_MS=60000
# Safety ceiling on how many assets are pulled into the in-memory index.
ADMIN_SCAN_LIMIT=5000

# --- Uploads -----------------------------------------------------------------
# Every uploaded file is streamed to disk here, then streamed on to Immich, then
# unlinked. Nothing is ever buffered whole in memory - a parent selecting 200
# iPhone photos must not be able to OOM a container with MemoryMax=5G that is
# shared with Immich and Postgres.
UPLOAD_TMP_DIR=/data/uploads-tmp
# No 10-photo cap anywhere: selecting an entire holiday is the normal case.
UPLOAD_MAX_FILES=500
UPLOAD_MAX_FILE_BYTES=67108864
UPLOAD_MAX_TOTAL_BYTES=2147483648
# Parallel uploads to Immich. Keep it low: Immich generates thumbnails
# synchronously on ingest and this box has no ML container to absorb the load.
UPLOAD_CONCURRENCY=2
# Per-file timeout talking to Immich during an upload.
UPLOAD_TIMEOUT_MS=300000
# Node's default request timeout is 5 minutes, which a 300-photo upload over
# mobile data will exceed. 30 minutes.
REQUEST_TIMEOUT_MS=1800000
# Accepted extensions. Empty = the built-in list, which covers everything a
# phone produces including HEIC/HEIF from iPhones, plus common raw formats.
UPLOAD_ALLOWED_EXTENSIONS=

# DELETE /api/admin/photos with mode=library sends assets to the IMMICH TRASH,
# which is recoverable from the Immich web UI. Setting this to true additionally
# allows {"force": true}, which is permanent and unrecoverable. There is no undo
# and there are no per-account restrictions - any of the three admins can do it.
ALLOW_PERMANENT_DELETE=false

# Extra paths served with no credential at all. The defaults are the login page
# assets and the favicon; add to this only if the login page needs another file
# (an icon, a font). Every entry is an exact path match.
PUBLIC_ASSET_PATHS=/login,/login.html,/login.css,/login.js,/favicon.ico

# -----------------------------------------------------------------------------
# Weather on the frame's clock (Open-Meteo, no key, no account)
# -----------------------------------------------------------------------------
# Set both to the GRANDPARENTS' town, not the server's. Leave either empty and
# no weather is shown.
WEATHER_LAT=
WEATHER_LON=
