# Frameo-clone signalling server — environment.
# Copy to .env (or merge into the stack-level .env) and fill in the secrets.
# Generate secrets with:  openssl rand -hex 32

# --- Required secret ------------------------------------------------------
# Bearer token for the HTTP control API (POST /api/call, POST /api/hangup).
# If unset, the control API is disabled and returns 503; signalling still works.
CONTROL_TOKEN=change-me-run-openssl-rand-hex-32

# --- Paths ----------------------------------------------------------------
# Roster JSON: the authoritative peer list and call whitelist (see roster.example.json).
# Inside the container the compose file mounts it read-only at /config/roster.json.
ROSTER_PATH=/config/roster.json

# JSONL audit trail: one line per call attempt. Mount a writable volume at /data.
CALL_LOG_PATH=/data/calls.jsonl

# Liveness table written by POST /api/frame-heartbeat, which the tablets call once
# a minute from tablet/tailscale-watchdog.sh. Defaults next to the call log, i.e.
# ${FRAMEO_ROOT}/logs/frame-heartbeats.json on the host, which is where
# server/frame-heartbeat-alert.sh looks for it.
FRAME_HEARTBEAT_PATH=/data/frame-heartbeats.json

# Static client files served over HTTP (authored separately).
PUBLIC_DIR=/app/public

# --- Network --------------------------------------------------------------
# HTTP + WebSocket share this port. Publish it on the host as 127.0.0.1:8080.
PORT=8080
# Bind inside the container; leave 0.0.0.0 so Docker can map it.
BIND_ADDR=0.0.0.0
# WebSocket endpoint path on the same port.
WS_PATH=/ws

# --- Behaviour ------------------------------------------------------------
# Unanswered ring is logged as "missed" after this many milliseconds.
RING_TIMEOUT_MS=45000
# ws ping/pong sweep; sockets that miss a round are dropped.
HEARTBEAT_INTERVAL_MS=30000
# A fresh socket must send "register" within this window or it is closed.
REGISTER_TIMEOUT_MS=10000
# Hard cap on simultaneous calls (project requirement: at most 2 concurrent 1:1 calls).
MAX_CONCURRENT_CALLS=2
# Roster file mtime poll interval for hot reload; 0 disables (SIGHUP still reloads).
ROSTER_RELOAD_MS=15000

# --- Frame liveness -------------------------------------------------------
# A frame counts as "stale" once no heartbeat has arrived for this long. It is
# the threshold frame-heartbeat-alert.sh alerts on, and it is reported back to
# the tablets in the heartbeat response.
FRAME_STALE_MS=900000
# Heartbeats arriving faster than this from one frame are answered 200 but not
# stored; the watchdog is meant to report once a minute.
FRAME_HEARTBEAT_MIN_MS=20000

# --- Admin login (see ../ARCHITECTURE-PUBLIC.md section 2) ------------------
# The gate. true = every path except the login page, POST /api/auth/login,
# GET /api/auth/session, POST /api/frame-heartbeat, the Bearer control API and a
# stubbed GET /api/health requires a credential. Never run false with a Funnel.
REQUIRE_AUTH=true
# Canonical public origin, no trailing slash. Used for the WebSocket Origin
# check and the CSP connect-src.
PUBLIC_ORIGIN=https://your-machine.your-tailnet.ts.net
# HMAC key for session cookies, device cookies and rate-limit bucketing.
#   openssl rand -hex 32
# Changing it logs everyone out and invalidates every device cookie at once.
SESSION_SECRET=
# Named accounts, scrypt-hashed, hot-reloaded. See admins.example.json.
ADMINS_PATH=/config/admins.json
# Optional extra accounts from the environment:
#   username|Display Name|rosterPeerId|scrypt$N=...$salt$hash
ADMIN_PASSWORD_HASHES=
ADMIN_DEFAULT_PEER_ID=family-ana
# Sessions survive a restart. Mode 0600.
SESSION_STORE_PATH=/data/sessions.json
SESSION_TTL_SECONDS=7776000
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_SOURCE=20
LOGIN_MAX_FAILURES_GLOBAL=100
LOGIN_LOCKOUT_SECONDS=900
LOGIN_SHOW_ACCOUNTS=false
COOKIE_SECURE=true
# Development only; MUST be empty in production.
EXTRA_ALLOWED_ORIGINS=

# --- Admin photo API -------------------------------------------------------
# Stable album keys for the phone UI: a / b / all. Empty = derived positionally
# from IMMICH_ALBUM_IDS.
IMMICH_ALBUM_A=
IMMICH_ALBUM_B=
IMMICH_ALBUM_ALL=
ADMIN_PAGE_SIZE=60
# Uploads are streamed to disk here and unlinked afterwards; nothing is buffered
# in memory.
UPLOAD_TMP_DIR=/data/uploads-tmp
UPLOAD_MAX_FILES=500
UPLOAD_MAX_FILE_BYTES=67108864
UPLOAD_MAX_TOTAL_BYTES=2147483648
UPLOAD_CONCURRENCY=2
# Node's 5-minute default would cut off a large phone upload.
REQUEST_TIMEOUT_MS=1800000
# mode=library deletes go to the Immich trash unless this is true.
ALLOW_PERMANENT_DELETE=false
