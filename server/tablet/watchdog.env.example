# frameo tablet watchdog configuration
#
# Copy to  /data/data/com.termux/files/home/.frameo/watchdog.env  on the TABLET
# (install-watchdog.sh does this for you) and fill in the two identity values.
#
# This file holds a secret. Keep it chmod 600 and never commit a filled-in copy.

# --- identity: must match ~/frameo/config/roster.json exactly --------
# The roster id of THIS tablet: frame-a or frame-b.
FRAME_ID=frame-a
# That peer's authToken from roster.json. It is the same token already present
# in the kiosk URL (?device=...&token=...), so this grants nothing extra.
FRAME_TOKEN=replace-with-the-authToken-from-roster.json

# --- server ------------------------------------------------------------------
# MagicDNS name of the server. Also the name on the Let's Encrypt certificate,
# over the tailnet and over the public Funnel alike.
SERVER_HOST=your-machine.your-tailnet.ts.net
# Tailnet address of the same machine. Replace with the output of `tailscale ip -4`
# on the server.
TAILNET_IP=100.64.0.1
# Public origin published by `tailscale funnel --bg --https=443`. The heartbeat
# goes here so it keeps arriving while the tailnet path is broken.
PUBLIC_URL=https://your-machine.your-tailnet.ts.net

# --- timing (seconds) --------------------------------------------------------
# Healthy cadence. 60s costs about one HTTPS request a minute.
CHECK_INTERVAL=60
# Cadence once BACKOFF_AFTER checks in a row have failed, so a genuinely dead
# tailnet does not keep the CPU and the radio busy all night.
BACKOFF_INTERVAL=300
BACKOFF_AFTER=5
# Wait this long after a reboot before judging Tailscale: Termux:Boot fires while
# Wi-Fi is still associating.
BOOT_DELAY=45
# How long a nudge gets to work before the next escalation step.
GRACE_AFTER_NUDGE=25
# After starting the Tailscale activity we bring FreeKiosk back to the front.
KIOSK_REFOCUS_DELAY=12
# Hard ceiling on force-stop cycles per hour.
FORCE_STOP_MAX_PER_HOUR=4

# --- optional ----------------------------------------------------------------
# Set to an explicit component if the HOME intent does not bring the kiosk back,
# e.g. KIOSK_COMPONENT=com.freekiosk/.MainActivity
# Find it with: adb shell dumpsys activity activities | grep mResumedActivity
#KIOSK_COMPONENT=
# Set to 0 to leave the Tailscale UI on screen after a restart (debugging only).
#REFOCUS_KIOSK=1
# One healthy line per N cycles; 0 silences them entirely.
#HEALTHY_LOG_EVERY=30
#LOG_MAX_BYTES=262144
#LOG_KEEP=3
